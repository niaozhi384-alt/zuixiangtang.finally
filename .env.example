# ── Supabase 免费线上数据库（https://supabase.com）────────────────
# 在 Supabase 控制台 → 项目 → Project Settings → API Keys 中复制：
#   SUPABASE_URL            = 项目地址，形如 https://项目ID.supabase.co
#   SUPABASE_ANON_KEY       = Publishable key（公开密钥，可放前端）
#   SUPABASE_SERVICE_ROLE_KEY = Secret key（服务端密钥，点 Reveal 显示，切勿泄露）
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── 首领后台登录 ────────────────────────────────────────────────
# 用户名与密码（密码务必改成你自己的强密码）
ADMIN_USERNAME=首领
ADMIN_PASSWORD=请改成强密码

# ── 会话签名密钥 ────────────────────────────────────────────────
# 任意随机长字符串（可用 64 位十六进制），用于给首领登录会话签名
SESSION_SECRET=

# ── 站点地址（用于 sitemap，可留空）──────────────────────────────
NEXT_PUBLIC_SITE_URL=https://zuixiangtang.vercel.app
